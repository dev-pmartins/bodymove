# URL pública do site (obrigatória p/ Open Graph / compartilhamento)
# Ex.: https://bodymove.com.br
VITE_SITE_URL=

# mock | live
VITE_SITE_CONTENT_MODE=live
VITE_INSTAGRAM_MODE=live

# Sheet CMS
VITE_GOOGLE_SCRIPT_URL=

# Cache localStorage (ms)
VITE_CMS_CACHE_TTL_MS=60000
VITE_INSTAGRAM_CACHE_TTL_MS=60000

# Instagram — DEV: proxy Vite | PROD: URL do Apps Script
VITE_INSTAGRAM_FEED_URL=/api/instagram
VITE_INSTAGRAM_PROFILE_URL=https://www.instagram.com/bodymove.funcional/

# Segredos do proxy (NUNCA use prefixo VITE_)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_LIMIT=6
