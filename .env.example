# Copie para .env.local e ajuste.

# mock | live
VITE_SITE_CONTENT_MODE=mock
VITE_INSTAGRAM_MODE=mock

# CSV publicado da Google Sheet (Forms → Sheet → Publicar na web)
# VITE_GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/XXXX/pub?gid=0&single=true&output=csv

# Proxy que devolve JSON do Instagram (nunca exponha o token no front)
# VITE_INSTAGRAM_FEED_URL=https://seu-worker.example/instagram
# VITE_INSTAGRAM_PROFILE_URL=https://www.instagram.com/seu_usuario/
